<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nanum+Gothic+Coding:wght@400;700&family=IBM+Plex+Sans+KR:wght@500;700&display=block" rel="stylesheet">
<style>
  :root {
    --bg: #2a46d1; --bg-ink: #f4f1ea; --paper: #f8f6f0; --ink: #23211e; --mute: #7b776f;
    --best: #d63a26; --near: #e07a12; --wait: #2f5fb8; --unknown: #8a8780;
    --mono: "Nanum Gothic Coding", monospace; --sans: "IBM Plex Sans KR", sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #333; font-family: var(--mono); color: var(--ink); -webkit-font-smoothing: antialiased; }
  .slide { width: 1080px; height: 1350px; background: var(--bg); position: relative; overflow: hidden; margin-bottom: 24px; }
  .slide::before { content: ""; position: absolute; inset: 0; opacity: .35; mix-blend-mode: soft-light; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='260' height='260'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/></filter><rect width='260' height='260' filter='url(%23n)'/></svg>"); }

  /* 배경 위 문구 */
  .outside { position: absolute; left: 64px; right: 64px; top: 56px; color: var(--bg-ink); display: flex; justify-content: space-between; align-items: flex-start; font-family: var(--sans); z-index: 3; }
  .outside .big { font-size: 64px; font-weight: 700; letter-spacing: -.03em; line-height: 1.08; }
  .outside .small { font-family: var(--mono); font-size: 22px; text-align: right; line-height: 1.5; opacity: .85; }
  .page { position: absolute; right: 64px; bottom: 44px; color: var(--bg-ink); font-size: 22px; opacity: .8; z-index: 3; }
  .sample { position: absolute; left: 64px; bottom: 44px; color: var(--bg-ink); font-size: 18px; opacity: .7; z-index: 3; }

  /* 영수증 */
  .slot { position: absolute; left: 50%; width: 820px; margin-left: -410px; top: 236px; bottom: -40px; overflow: hidden; padding: 0 30px; }
  .tilt { transform: rotate(-1.4deg); transform-origin: top center; filter: drop-shadow(0 22px 26px rgba(0,0,0,.28)) drop-shadow(0 2px 3px rgba(0,0,0,.2)); }
  .receipt { background: var(--paper); padding: 44px 50px 50px; position: relative; font-size: 28px; line-height: 1.48;
             animation: print 1.5s cubic-bezier(.3,.1,.2,1) both; }
  .receipt::before { content: ""; position: absolute; inset: 0; opacity: .6; mix-blend-mode: multiply; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='1.1' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .4  0 0 0 0 .38  0 0 0 0 .34  0 0 0 .18 0'/></filter><rect width='200' height='200' filter='url(%23n)'/></svg>"); }
  .receipt::after { content: ""; position: absolute; left: 0; right: 0; bottom: -15px; height: 16px;
    background: linear-gradient(135deg, var(--paper) 8px, transparent 0) 0 0 / 16px 16px repeat-x, linear-gradient(-135deg, var(--paper) 8px, transparent 0) 0 0 / 16px 16px repeat-x; }
  @keyframes print { from { transform: translateY(-104%) } to { transform: none } }
  .c { text-align: center; }
  .head { font-weight: 700; font-size: 34px; letter-spacing: .06em; }
  .dash { border: 0; border-top: 2px dashed #b9b4aa; margin: 18px 0; }
  .dbl { border: 0; border-top: 5px double var(--ink); margin: 16px 0; }
  .ln { display: flex; justify-content: space-between; gap: 18px; white-space: nowrap; }
  .ln span:first-child { overflow: hidden; text-overflow: ellipsis; }
  .ln.dots span:first-child::after { content: " ................................................................"; color: #b9b4aa; }
  .ln.dots span:first-child { flex: 1; }
  .mute { color: var(--mute); }
  .total { font-size: 34px; font-weight: 700; align-items: baseline; }
  .total b { font-size: 70px; letter-spacing: -.02em; }
  .print { margin: 6px -6px; height: 280px; overflow: hidden; position: relative; background: #fff; }
  .print img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.3) brightness(1.05); mix-blend-mode: multiply; }
  .print::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle, transparent 1.1px, var(--paper) 1.5px) 0 0 / 5px 5px; opacity: .55; }
  .title { font-weight: 700; font-size: 44px; line-height: 1.25; white-space: normal; }
  .barcode { display: block; margin: 14px auto 6px; }
  .tiny { font-size: 21px; }

  /* 도장 */
  .stamp { position: absolute; z-index: 4; color: var(--sc); border: 7px solid var(--sc); border-radius: 18px; padding: 12px 26px 10px;
           text-align: center; font-family: var(--sans); font-weight: 700; mix-blend-mode: multiply; filter: url(#ink);
           transform: rotate(-11deg); animation: slam .38s 1.55s cubic-bezier(.3,1.6,.5,1) both; }
  .stamp::before { content: ""; position: absolute; inset: 5px; border: 2px solid var(--sc); border-radius: 10px; }
  .stamp b { display: block; font-size: 64px; line-height: 1.05; letter-spacing: -.02em; }
  .stamp small { display: block; font-family: var(--mono); font-size: 20px; letter-spacing: .1em; }
  .v-best { --sc: var(--best); } .v-near { --sc: var(--near); } .v-wait { --sc: var(--wait); } .v-unknown { --sc: var(--unknown); }
  @keyframes slam { 0% { opacity: 0; transform: rotate(-4deg) scale(2.3) } 60% { opacity: 1 } 100% { opacity: .88; transform: rotate(-11deg) scale(1) } }
</style>
</head>
<body>
{% include "_grain.html.j2" %}
{% set stamp_text = {"best": ("역대최저", "LOWEST EVER"), "near": ("최저근접", "NEAR LOW"), "wait": ("대기권장", "WAIT"), "unknown": ("추적중", "TRACKING")} %}
{% macro barcode(seed, w=420, h=70) -%}
<svg class="barcode" width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}">
{%- set ns = namespace(x=0) -%}
{%- for ch in (seed ~ seed ~ seed ~ seed)[:60] -%}
  {%- set bw = (ch|string|first|ord) % 3 + 1 -%}
  {%- if ns.x + bw * 2 < w -%}<rect x="{{ ns.x }}" y="0" width="{{ bw * 2 }}" height="{{ h }}" fill="#23211e"/>{%- endif -%}
  {%- set ns.x = ns.x + bw * 2 + ((ch|string|first|ord) % 2 + 1) * 3 -%}
{%- endfor -%}
</svg>
{%- endmacro %}
{% for s in slides %}{% set n = loop.index %}

{% if s.kind == "cover" %}
<section class="slide">
  <div class="outside"><div class="big">이번 주<br>할인 영수증</div><div class="small">{{ week.range }}<br>{{ handle }}</div></div>
  <div class="slot"><div class="tilt"><div class="receipt">
    <div class="c head">{{ brand }}</div>
    <div class="c mute tiny">영수증 No.{{ week.year }}-{{ week.no }} · 엄선 {{ s.deal_count }}건</div>
    <hr class="dash">
    {% for d in s.deals %}
    <div class="ln"><span>{{ loop.index|pad2 }} {{ d.title }}</span><span>₩{{ d.price|won }}</span></div>
    <div class="ln mute tiny" style="margin-bottom:8px"><span>&nbsp;&nbsp;&nbsp;{{ d.store|store_name }} 정가 ₩{{ d.regular|won }}</span><span>-{{ d.discount }}%</span></div>
    {% endfor %}
    <hr class="dbl">
    <div class="ln total"><span>할인 합계</span><b data-count-from="0" data-count-to="{{ s.savings }}" data-count-start="1.0" data-count-dur="1.2" data-prefix="-₩" data-round="10">-₩{{ s.savings|won }}</b></div>
    <hr class="dbl">
    <div class="ln dots"><span>최대 할인율</span><span>{{ s.max_pct }}%</span></div>
    <div class="ln dots"><span>무료 배포</span><span>{{ s.free_count }}건</span></div>
    <div class="ln dots"><span>선별 기준</span><span>평가 {{ min_review }}%↑</span></div>
    <hr class="dash">
    {{ barcode(week.no ~ "deal" ~ week.year) }}
    <div class="c mute tiny">넘겨서 품목별 영수증 확인 →</div>
  </div></div></div>
  <div class="page">{{ n|pad2 }}/{{ total|pad2 }}</div>
  {% if sample %}<div class="sample">샘플 데이터</div>{% endif %}
</section>

{% elif s.kind == "hero" %}{% set d = s.deal %}{% set st = stamp_text[d.verdict] %}
<section class="slide">
  <div class="outside"><div class="big" style="font-size:44px">{{ s.rank|pad2 }}<span style="opacity:.6"> / {{ d.store|store_name }}</span></div><div class="small">{{ brand }}<br>No.{{ week.no }}</div></div>
  <div class="slot" style="top:150px"><div class="tilt"><div class="receipt">
    <div class="c head">{{ d.store|store_name|upper }}</div>
    <div class="c mute tiny">{{ week.range }} · No.{{ week.no }}-{{ s.rank|pad2 }}</div>
    <hr class="dash">
    <div class="print"><img src="{{ d.art_wide or d.image }}" alt=""></div>
    <hr class="dash">
    <div class="title">{{ d.title }}</div>
    {% if d.tags %}<div class="mute tiny">{{ d.tags|join(' · ') }}</div>{% endif %}
    <hr class="dash">
    <div class="ln"><span>정가</span><span>₩{{ d.regular|won }}</span></div>
    <div class="ln"><span>할인 (-{{ d.discount }}%)</span><span>-₩{{ (d.regular - d.price)|won }}</span></div>
    <hr class="dbl">
    <div class="ln total"><span>결제 금액</span><b data-count-from="{{ d.regular }}" data-count-to="{{ d.price }}" data-count-start="0.8" data-count-dur="1.0" data-prefix="₩" data-round="10">₩{{ d.price|won }}</b></div>
    <hr class="dbl">
    <div class="ln dots"><span>한국어</span><span>{{ d.korean or '미확인' }}</span></div>
    {% if d.review_pct is not none %}<div class="ln dots"><span>평가</span><span>{{ d.review_pct }}%{% if d.review_count %} ({{ d.review_count|compact }}){% endif %}</span></div>{% endif %}
    <div class="ln dots"><span>역대 최저가</span><span>{% if d.history_low %}₩{{ d.history_low|won }}{% else %}기록 중{% endif %}</span></div>
    {% if d.currency_note %}<div class="ln dots"><span>실결제</span><span>{{ d.currency_note }}</span></div>{% endif %}
    <hr class="dash">
    {{ barcode(d.store_id) }}
    <div class="c mute tiny">{{ d.url|short_url }}</div>
  </div></div></div>
  <div class="stamp v-{{ d.verdict }}" style="left:560px; top:{{ 1000 if d.title|length < 20 else 1050 }}px"><b>{{ st[0] }}</b><small>{{ st[1] }}</small></div>
  <div class="page">{{ n|pad2 }}/{{ total|pad2 }}</div>
  {% if sample %}<div class="sample">샘플 데이터</div>{% endif %}
</section>

{% elif s.kind == "list" %}
<section class="slide">
  <div class="outside"><div class="big">추가 품목</div><div class="small">{{ brand }}<br>No.{{ week.no }}</div></div>
  <div class="slot" style="top:200px"><div class="tilt"><div class="receipt">
    <div class="c head">추가 영수증</div>
    <hr class="dash">
    {% for d in s.deals %}
    <div class="ln"><span>{{ (s.offset + loop.index)|pad2 }} {{ d.title }}</span><span>₩{{ d.price|won }}</span></div>
    <div class="ln mute tiny" style="margin-bottom:12px"><span>&nbsp;&nbsp;&nbsp;{{ d.store|store_name }} · 한국어 {{ d.korean or '미확인' }}{% if d.verdict == 'best' %} · 역대최저{% endif %}</span><span>-{{ d.discount }}%</span></div>
    {% endfor %}
    <hr class="dbl">
    <div class="ln total"><span>할인 합계</span><b style="font-size:52px">-₩{{ (s.deals|sum(attribute='regular') - s.deals|sum(attribute='price'))|won }}</b></div>
    <hr class="dash">
    <div class="c mute tiny">가격은 게시 시점 기준입니다</div>
  </div></div></div>
  <div class="page">{{ n|pad2 }}/{{ total|pad2 }}</div>
</section>

{% elif s.kind == "free" %}
<section class="slide">
  <div class="outside"><div class="big">0원 영수증</div><div class="small">Epic Games Store<br>목요일 자정 교체</div></div>
  <div class="slot" style="top:200px"><div class="tilt"><div class="receipt">
    <div class="c head">EPIC GAMES</div>
    <hr class="dash">
    {% for g in s.games %}
    <div class="print" style="height:200px"><img src="{{ g.image }}" alt=""></div>
    <div class="title" style="font-size:32px; margin-top:10px">{{ g.title }}</div>
    <div class="ln"><span>정가</span><span>₩{{ g.regular|won }}</span></div>
    <div class="ln total" style="font-size:28px"><span>{% if g.upcoming %}{{ g.starts_at|kdate }}부터{% else %}{{ g.ends_at|kdatetime }}까지{% endif %}</span><b style="font-size:54px">₩0</b></div>
    <hr class="dash">
    {% endfor %}
    <div class="c mute tiny">계정에 추가하면 영구 소장</div>
  </div></div></div>
  <div class="stamp v-best" style="left:600px; top:560px"><b>무료</b><small>FREE</small></div>
  <div class="page">{{ n|pad2 }}/{{ total|pad2 }}</div>
</section>

{% elif s.kind == "cta" %}
<section class="slide">
  <div class="outside"><div class="big">영수증은<br>챙겨 두세요</div><div class="small">{{ handle }}</div></div>
  <div class="slot" style="top:330px"><div class="tilt"><div class="receipt">
    <div class="c head">고객 안내</div>
    <hr class="dash">
    <div class="ln"><span>01 저장</span><span>세일 끝나기 전 확인</span></div>
    <div class="ln"><span>02 댓글</span><span>기다리는 게임 남기기</span></div>
    <div class="ln"><span>03 알림</span><span>목요일 자정 무료게임</span></div>
    <hr class="dbl">
    <div class="ln dots"><span>역대최저</span><span>지금 사도 됨</span></div>
    <div class="ln dots"><span>최저근접</span><span>거의 바닥</span></div>
    <div class="ln dots"><span>대기권장</span><span>더 싸진 적 있음</span></div>
    <hr class="dash">
    <div class="tiny mute">공식 스토어와 공인 키셀러만 소개합니다. 가격은 게시 시점 기준이며 바뀔 수 있습니다.{% if affiliate %} 이 게시물에는 제휴 링크가 포함되어 있으며, 구매 시 수수료를 받을 수 있습니다.{% endif %}</div>
    {{ barcode(handle) }}
    <div class="c head" style="font-size:28px">감사합니다</div>
  </div></div></div>
  <div class="page">{{ n|pad2 }}/{{ total|pad2 }}</div>
</section>
{% endif %}
{% endfor %}
{% include "_runtime.html.j2" %}
</body>
</html>
