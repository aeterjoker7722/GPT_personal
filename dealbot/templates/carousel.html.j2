<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css">
<style>
  :root {
    --bg: #0d1017; --panel: #161b25; --line: #262d3b;
    --text: #f3f5f8; --sub: #9aa4b5; --accent: #c8ff3c; --accent-ink: #11160a;
    --best: #34d399; --near: #fbbf24; --wait: #f87171; --unknown: #7c8696;
    --steam: #66c0f4; --gog: #b57cf2; --epic: #e8e8e8; --directg: #ff7a45; --stove: #ff5a5a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #000; font-family: Pretendard, "WenQuanYi Zen Hei", sans-serif; color: var(--text); }
  .slide { width: 1080px; height: 1350px; background: var(--bg); position: relative; overflow: hidden;
           padding: 72px 72px 64px; display: flex; flex-direction: column; margin-bottom: 20px; }
  .top { display: flex; justify-content: space-between; align-items: center; font-size: 26px; color: var(--sub); font-weight: 600; }
  .handle { color: var(--text); }
  .foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; font-size: 24px; color: var(--sub); }
  .chip { display: inline-flex; align-items: center; gap: 10px; padding: 10px 20px; border-radius: 999px;
          background: var(--panel); border: 2px solid var(--line); font-size: 26px; font-weight: 700; }
  .chip .dot { width: 14px; height: 14px; border-radius: 50%; }
  .store-steam .dot { background: var(--steam); } .store-gog .dot { background: var(--gog); }
  .store-epic .dot { background: var(--epic); } .store-directg .dot { background: var(--directg); }
  .store-stove .dot { background: var(--stove); }

  /* cover */
  .cover h1 { font-size: 132px; line-height: 1.04; font-weight: 900; letter-spacing: -4px; margin-top: 120px; }
  .cover h1 em { font-style: normal; color: var(--accent); }
  .cover .range { font-size: 40px; color: var(--sub); margin-top: 32px; font-weight: 600; }
  .cover .stats { display: flex; gap: 24px; margin-top: 72px; }
  .stat { flex: 1; background: var(--panel); border: 2px solid var(--line); border-radius: 28px; padding: 32px 36px; }
  .stat b { display: block; font-size: 84px; font-weight: 900; color: var(--accent); line-height: 1; }
  .stat span { font-size: 28px; color: var(--sub); font-weight: 600; }
  .cover .stores { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 56px; }
  .legend { display: flex; gap: 28px; margin-top: 48px; font-size: 26px; color: var(--sub); font-weight: 600; }
  .legend i { display: inline-block; width: 18px; height: 18px; border-radius: 50%; margin-right: 10px; vertical-align: -2px; }
  .swipe { font-size: 30px; font-weight: 800; color: var(--accent); }

  /* hero deal */
  .hero .art { margin: 40px -72px 0; height: 506px; background: #000 center/cover no-repeat; position: relative; }
  .hero .art::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, var(--bg)); }
  .hero .rank { position: absolute; left: 72px; top: 28px; z-index: 2; background: var(--accent); color: var(--accent-ink);
                font-size: 34px; font-weight: 900; padding: 8px 22px; border-radius: 14px; }
  .hero .meta { display: flex; gap: 14px; margin-top: 8px; flex-wrap: wrap; }
  .hero h2 { font-size: 68px; line-height: 1.12; font-weight: 900; letter-spacing: -2px; margin-top: 26px;
             display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .price-row { display: flex; align-items: flex-end; gap: 28px; margin-top: 30px; }
  .pct { background: var(--accent); color: var(--accent-ink); font-size: 88px; font-weight: 900; line-height: 1;
         padding: 14px 24px; border-radius: 20px; letter-spacing: -3px; }
  .price b { display: block; font-size: 92px; font-weight: 900; line-height: 1; letter-spacing: -3px; }
  .price s { font-size: 34px; color: var(--sub); }
  .price small { font-size: 24px; color: var(--sub); margin-left: 12px; }
  .verdict { margin-top: 36px; display: flex; align-items: center; gap: 22px; padding: 26px 30px; border-radius: 24px;
             background: var(--panel); border: 3px solid var(--vc); }
  .verdict .lamp { width: 30px; height: 30px; border-radius: 50%; background: var(--vc); box-shadow: 0 0 24px var(--vc); flex: none; }
  .verdict b { font-size: 40px; font-weight: 900; color: var(--vc); }
  .verdict span { font-size: 28px; color: var(--sub); display: block; margin-top: 4px; font-weight: 600; }
  .v-best { --vc: var(--best); } .v-near { --vc: var(--near); } .v-wait { --vc: var(--wait); } .v-unknown { --vc: var(--unknown); }
  .facts { display: flex; gap: 14px; margin-top: 24px; flex-wrap: wrap; }
  .fact { font-size: 26px; font-weight: 700; padding: 10px 18px; border-radius: 12px; background: var(--panel); border: 2px solid var(--line); }
  .fact.ko-음성, .fact.ko-자막 { border-color: var(--best); color: var(--best); }
  .fact.ko-미지원 { border-color: var(--wait); color: var(--wait); }

  /* list */
  .list h3, .free h3 { font-size: 64px; font-weight: 900; letter-spacing: -2px; margin-top: 36px; }
  .list h3 em, .free h3 em { font-style: normal; color: var(--accent); }
  .rows { margin-top: 36px; display: flex; flex-direction: column; gap: 18px; }
  .row { display: flex; align-items: center; gap: 24px; background: var(--panel); border-radius: 22px; padding: 18px; border: 2px solid var(--line); }
  .row .thumb { width: 230px; height: 108px; border-radius: 12px; background: #000 center/cover no-repeat; flex: none; }
  .row .info { flex: 1; min-width: 0; }
  .row .t { font-size: 32px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row .s { font-size: 24px; color: var(--sub); margin-top: 6px; font-weight: 600; }
  .row .s i { display: inline-block; width: 14px; height: 14px; border-radius: 50%; background: var(--vc); margin-right: 8px; }
  .row .p { text-align: right; flex: none; }
  .row .p em { font-style: normal; display: inline-block; background: var(--accent); color: var(--accent-ink); font-weight: 900; font-size: 26px; padding: 4px 12px; border-radius: 8px; }
  .row .p b { display: block; font-size: 36px; font-weight: 900; margin-top: 6px; }

  /* free */
  .fcard { margin-top: 32px; background: var(--panel); border-radius: 28px; overflow: hidden; border: 2px solid var(--line); }
  .fcard .img { height: 330px; background: #000 center/cover no-repeat; }
  .fcard .body { padding: 26px 32px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .fcard .t { font-size: 40px; font-weight: 900; }
  .fcard .d { font-size: 26px; color: var(--sub); margin-top: 6px; font-weight: 600; }
  .fcard .badge { background: var(--accent); color: var(--accent-ink); font-size: 34px; font-weight: 900; padding: 10px 22px; border-radius: 14px; flex: none; }
  .fcard.next .badge { background: var(--line); color: var(--text); }
  .fcard.next { opacity: .9; }

  /* cta */
  .cta h3 { font-size: 92px; font-weight: 900; letter-spacing: -3px; line-height: 1.1; margin-top: 140px; }
  .cta h3 em { font-style: normal; color: var(--accent); }
  .cta ul { list-style: none; margin-top: 72px; display: flex; flex-direction: column; gap: 24px; }
  .cta li { font-size: 38px; font-weight: 700; background: var(--panel); border: 2px solid var(--line); border-radius: 24px; padding: 30px 34px; }
  .cta li b { color: var(--accent); }
  .disclaimer { font-size: 22px; color: var(--sub); margin-top: 40px; line-height: 1.5; }
</style>
</head>
<body>
{% set total = slides|length %}
{% for s in slides %}
{% set n = loop.index %}

{% if s.kind == "cover" %}
<section class="slide cover">
  <div class="top"><span class="handle">{{ handle }}</span><span>{{ s.issue }}</span></div>
  <h1>{{ s.title_1 }}<br><em>{{ s.title_2 }}</em></h1>
  <div class="range">{{ s.range }}</div>
  <div class="stats">
    <div class="stat"><b>{{ s.deal_count }}</b><span>엄선 할인</span></div>
    <div class="stat"><b>{{ s.max_pct }}%</b><span>최대 할인율</span></div>
    <div class="stat"><b>{{ s.free_count }}</b><span>무료 배포</span></div>
  </div>
  <div class="stores">{% for st in s.stores %}<span class="chip store-{{ st }}"><span class="dot"></span>{{ st|store_name }}</span>{% endfor %}</div>
  <div class="legend"><span><i style="background:var(--best)"></i>역대 최저가</span><span><i style="background:var(--near)"></i>최저가 근접</span><span><i style="background:var(--wait)"></i>더 기다리기</span></div>
  <div class="foot"><span>평가 {{ min_review }}% 이상 · 할인 {{ min_discount }}% 이상만</span><span class="swipe">넘겨보기 →</span></div>
</section>

{% elif s.kind == "hero" %}{% set d = s.deal %}
<section class="slide hero">
  <div class="top"><span class="handle">{{ handle }}</span><span>{{ n }} / {{ total }}</span></div>
  <div class="art" style="background-image:url('{{ d.image }}')"><span class="rank">#{{ s.rank }}</span></div>
  <div class="meta">
    <span class="chip store-{{ d.store }}"><span class="dot"></span>{{ d.store|store_name }}</span>
    {% for t in d.tags[:2] %}<span class="chip">{{ t }}</span>{% endfor %}
  </div>
  <h2>{{ d.title }}</h2>
  <div class="price-row">
    <div class="pct">-{{ d.discount }}%</div>
    <div class="price"><s>₩{{ d.regular|won }}</s><b>₩{{ d.price|won }}</b></div>
  </div>
  {% if d.currency_note %}<div class="facts"><span class="fact">{{ d.currency_note }}</span></div>{% endif %}
  <div class="verdict v-{{ d.verdict }}">
    <span class="lamp"></span>
    <div><b>{{ d.verdict|verdict_label }}</b><span>{{ d.verdict_note }}</span></div>
  </div>
  <div class="facts">
    <span class="fact ko-{{ d.korean or '미확인' }}">한국어 {{ d.korean or '미확인' }}</span>
    {% if d.review_pct is not none %}<span class="fact">평가 {{ d.review_pct }}%{% if d.review_count %} · {{ d.review_count|compact }}개{% endif %}</span>{% endif %}
    {% if d.ends_at %}<span class="fact">~{{ d.ends_at|kdate }} 종료</span>{% endif %}
  </div>
  <div class="foot"><span>{{ d.url|short_url }}</span><span class="swipe">→</span></div>
</section>

{% elif s.kind == "list" %}
<section class="slide list">
  <div class="top"><span class="handle">{{ handle }}</span><span>{{ n }} / {{ total }}</span></div>
  <h3>{{ s.title }} <em>{{ s.subtitle }}</em></h3>
  <div class="rows">
  {% for d in s.deals %}
    <div class="row v-{{ d.verdict }}">
      <div class="thumb" style="background-image:url('{{ d.image }}')"></div>
      <div class="info">
        <div class="t">{{ d.title }}</div>
        <div class="s"><i></i>{{ d.verdict|verdict_label }} · {{ d.store|store_name }} · 한국어 {{ d.korean or '미확인' }}</div>
      </div>
      <div class="p"><em>-{{ d.discount }}%</em><b>₩{{ d.price|won }}</b></div>
    </div>
  {% endfor %}
  </div>
  <div class="foot"><span>가격은 게시 시점 기준</span><span class="swipe">→</span></div>
</section>

{% elif s.kind == "free" %}
<section class="slide free">
  <div class="top"><span class="handle">{{ handle }}</span><span>{{ n }} / {{ total }}</span></div>
  <h3>에픽 <em>무료 게임</em></h3>
  {% for g in s.games[:3] %}
  <div class="fcard {% if g.upcoming %}next{% endif %}">
    <div class="img" style="background-image:url('{{ g.image }}')"></div>
    <div class="body">
      <div><div class="t">{{ g.title }}</div>
        <div class="d">{% if g.upcoming %}{{ g.starts_at|kdate }} 공개 예정{% else %}{{ g.ends_at|kdatetime }}까지{% endif %}{% if g.regular %} · 정가 ₩{{ g.regular|won }}{% endif %}</div></div>
      <span class="badge">{% if g.upcoming %}다음 주{% else %}지금 무료{% endif %}</span>
    </div>
  </div>
  {% endfor %}
  <div class="foot"><span>매주 목요일 자정(한국 시간) 교체</span><span class="swipe">→</span></div>
</section>

{% elif s.kind == "cta" %}
<section class="slide cta">
  <div class="top"><span class="handle">{{ handle }}</span><span>{{ n }} / {{ total }}</span></div>
  <h3>놓치기 전에<br><em>저장</em>해 두세요</h3>
  <ul>
    <li>💬 기다리는 게임을 <b>댓글</b>로 남기면 할인할 때 알려드려요</li>
    <li>🔔 에픽 무료게임은 <b>목요일 자정</b> 스토리에 바로 올려요</li>
    <li>🟢 역대 최저가일 때만 <b>"지금 사세요"</b>라고 해요</li>
  </ul>
  <p class="disclaimer">공식 스토어와 공인 키셀러 링크만 소개합니다. 가격은 게시 시점 기준이며 바뀔 수 있습니다.{% if affiliate %}<br>이 게시물에는 제휴 링크가 포함되어 있으며, 구매 시 수수료를 받을 수 있습니다.{% endif %}</p>
  <div class="foot"><span class="handle">{{ handle }}</span><span>프로필 링크에서 전체 목록 보기</span></div>
</section>
{% endif %}
{% endfor %}
</body>
</html>
